{
  "name": "@qorpiq/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Indian company and director data (MCA registry): CIN, LLPIN, DIN lookups, MCA status and new incorporations, powered by QorpIQ.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "qorpiq-mcp": "./dist/stdio.js"
  },
  "main": "./dist/tools.js",
  "types": "./dist/tools.d.ts",
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/stdio.js",
    "dev": "tsx src/stdio.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "india",
    "mca",
    "company-data",
    "cin",
    "din",
    "kyb",
    "ministry-of-corporate-affairs",
    "qorpiq"
  ],
  "homepage": "https://qorpiq.com/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/QorpIQ/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/QorpIQ/mcp-server/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
